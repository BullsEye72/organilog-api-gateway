# Overrides the deny-all in ../.htaccess for the web root only.
Require all granted
Options -Indexes

RewriteEngine On

# HTTPS only. API keys travel in a header, so a plain-HTTP request would expose them.
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# PHP-FPM drops the Authorization header unless it is copied into the environment.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteRule ^v1(/.*)?$ api.php [L,QSA]

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
</IfModule>
